# ──────────────────────────────────────────────────────────────────────
# Katha Template Studio — environment variables
# Copy to .env.local for local dev, or paste into Vercel project settings
# ──────────────────────────────────────────────────────────────────────

# ── Studio gate (required for production) ─────────────────────────────
# HTTP Basic auth password for the admin studio at /
# Without it, the studio is publicly accessible.
# Username can be anything; only password is checked.
STUDIO_PASSWORD=

# ── Email notifications (required for /api/selection dispatch) ────────
# Resend API key — sign up free at https://resend.com
# When set, every gallery selection emails you the client's pick.
RESEND_API_KEY=
# Where to send notifications. Defaults to kathabooth@gmail.com if unset.
NOTIFICATION_EMAIL=kathabooth@gmail.com
# Optional From address override. Default: "Katha <onboarding@resend.dev>"
# (works without verifying kathabooth.com). Once you verify the domain with
# Resend, change to e.g. "Katha <hello@kathabooth.com>"
NOTIFICATION_FROM=

# ── HoneyBook sync (optional — Phase D upgrade, not required to launch) ─
# When set, /api/selection also pushes the pick to your HoneyBook project.
# HONEYBOOK_API_KEY=
# HONEYBOOK_WEBHOOK_URL=     # alternative: a Zapier catch-hook URL

# ── Supabase (optional — Phase D upgrade for persistence) ─────────────
# NEXT_PUBLIC_SUPABASE_URL=https://hvvomiyskizxzhyytcfd.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (Vercel sets this automatically in production) ────────────
APP_URL=http://localhost:3000
